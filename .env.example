# Plant & flower identification (Claude vision API)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Weather dashboard (Vaisala Xweather API)
# Create a free application at https://account.xweather.com/ to get an ID/secret pair
XWEATHER_CLIENT_ID=your_client_id_here
XWEATHER_CLIENT_SECRET=your_client_secret_here
