# Plant & flower identification (Claude vision API)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Weather dashboard (Vaisala Xweather API)
# Create a free application at https://account.xweather.com/ to get an ID/secret pair
XWEATHER_CLIENT_ID=your_client_id_here
XWEATHER_CLIENT_SECRET=your_client_secret_here


# Football fixtures (football-data.org) — optional, for /weather Local tab.
FOOTBALL_DATA_TOKEN=your_football_data_token_here
FOOTBALL_TEAM=Swansea
FOOTBALL_COMPETITION=ELC

# Optional. Met Office Weather DataHub, used only for the weather app's
# "Second opinion" comparison card. Free plan allows 360 calls a day; the app
# caches for 30 minutes, so one location costs roughly 48. Sign up at
# https://datahub.metoffice.gov.uk/ and subscribe to the Site Specific product.
METOFFICE_API_KEY=

# Optional. Met Office DataHub "map images" product — a separate subscription
# and key from the site-specific forecast above. Free plan allows 1000 images
# a day. Falls back to METOFFICE_API_KEY if unset.
METOFFICE_MAP_API_KEY=
